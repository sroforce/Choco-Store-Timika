rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── HELPER ─────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024; // Maks 10MB
    }

    // ─── PRODUK: Publik baca, Admin upload ──────────────────────────────
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ─── GALERI: Publik baca, Admin upload ──────────────────────────────
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ─── BRAND ASSETS: Publik baca, Admin upload ────────────────────────
    match /brand/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ─── DEFAULT: Tolak semua ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
